{
  "manifest_version": 3,
  "name": "YouTube Auto Continue",
  "short_name": "Auto Continue",
  "version": "1.0.0",
  "description": "Automatically confirms YouTube's continue-watching prompt.",
  "permissions": [],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://music.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
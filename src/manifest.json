{
  "manifest_version": 3,
  "name": "yesYouTube",
  "short_name": "yesYouTube",
  "version": "1.0.0",
  "description": "Automatically confirms YouTube's \"Video paused. Continue watching?\" inactivity prompt.",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
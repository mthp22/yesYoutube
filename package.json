{
  "name": "yesYoutube",
  "version": "1.0.0",
  "private": true,
  "description": "Automatically confirms YouTube's continue-watching prompt.",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "build:debug": "tsx scripts/build.ts --debug",
    "watch": "tsx scripts/build.ts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/chrome": "^0.1.32",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^5.1.0"
  }
}

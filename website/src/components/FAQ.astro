---
import SectionHeading from './SectionHeading.astro';

const questions = [
  {
    question: 'What exactly does YesYouTube do?',
    answer: "YesYouTube detects YouTube's inactivity confirmation dialog — Video paused. Continue Watching? — and automatically clicks its valid confirmation button so playback can continue."
  },
  {
    question: 'Does it work with YouTube Music?',
    answer: 'Yes. The extension supports both www.youtube.com and music.youtube.com.'
  },
  {
    question: 'Does YesYouTube need browser permissions?',
    answer: 'The extension does not declare additional permissions or a separate host_permissions entry. Its content script is restricted to the two supported YouTube websites.'
  },
  {
    question: 'Does it collect my browsing data?',
    answer: 'No. YesYouTube does not collect browsing history, use analytics, store personal information or make network requests.'
  },
  {
    question: 'How does it avoid clicking unrelated buttons?',
    answer: 'It first verifies a configured dialog, checks its visibility and prompt text, then searches for an enabled, visible confirmation button inside that dialog only.'
  },
  {
    question: 'Does it guarantee uninterrupted playback?',
    answer: 'No. It attempts to confirm the inactivity prompt automatically, but YouTube may still pause playback for other reasons.'
  },
  {
    question: 'Can I inspect or modify the source code?',
    answer: 'Yes. YesYouTube is an open-source TypeScript project. You can inspect the implementation, run the tests and build it locally.'
  },
  {
    question: 'How do I know whether detection is working?',
    answer: 'Build the debug version, reload the extension and inspect the browser DevTools console for messages prefixed with [yesYouTube].'
  }
];
---

<section class="yy-section faq-section" id="faq">
  <div class="yy-container">

    <SectionHeading
      eyebrow="Questions & answers"
      title="Things you might be wondering."
      description="A few details about how YesYouTube works, its limitations and privacy."
      centered={true}
    />

    <div class="faq-list mt-5">

      {questions.map((item) => (
        <details class="faq-item" data-reveal>
          <summary>
            <span>{item.question}</span>
            <span class="faq-toggle" aria-hidden="true">+</span>
          </summary>

          <div class="faq-answer">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}

    </div>

  </div>
</section>

<style>
  .faq-section {
    background: var(--yy-bg-soft);
  }

  .faq-list {
    max-width: 820px;
    margin-inline: auto;
  }

  .faq-item {
    margin-bottom: 12px;
    padding: 0 23px;
    background: var(--yy-surface);
    border: 1px solid var(--yy-border);
    border-radius: 14px;
    transition: border-color .2s ease;
  }

  .faq-item[open] {
    border-color: rgba(240,68,68,.35);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 75px;
    cursor: pointer;
    list-style: none;
    color: var(--yy-text);
    font-size: .96rem;
    font-weight: 650;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-toggle {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    background: var(--yy-surface-hover);
    border-radius: 9px;
    color: var(--yy-red);
    font-size: 1.2rem;
    transition: transform .2s ease;
  }

  .faq-item[open] .faq-toggle {
    transform: rotate(45deg);
  }

  .faq-answer {
    padding: 0 35px 22px 0;
  }

  .faq-answer p {
    margin: 0;
    font-size: .9rem;
    line-height: 1.8;
  }

  @media(max-width: 600px) {
    .faq-item {
      padding-inline: 17px;
    }

    .faq-item summary {
      font-size: .88rem;
    }
  }
</style>

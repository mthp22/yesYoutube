---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="yy-footer">
  <div class="yy-container">

    <div class="footer-main">

      <div class="footer-brand">
        <a href={`${base}/`} class="yy-brand">
          <img
            src={`${base}/media/logo.png`}
            alt=""
            width="36"
            height="36"
          />
          <span>yes<span>YouTube</span></span>
        </a>

        <p>
          Less interruption.<br />
          More watching.
        </p>
      </div>

      <div class="footer-column">
        <h3>Explore</h3>
        <a href={`${base}/how-it-works/`}>How it works</a>
        <a href={`${base}/privacy/`}>Privacy & security</a>
        <a href={`${base}/docs/`}>Documentation</a>
      </div>

      <div class="footer-column">
        <h3>Project</h3>
        <a
          href="https://github.com/YOUR_USERNAME/YesYouTube"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub repository ↗
        </a>
        <a href={`${base}/docs/#installation`}>Installation</a>
        <a href={`${base}/docs/#development`}>Development</a>
      </div>

    </div>

    <div class="yy-divider"></div>

    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} YesYouTube</span>
      <span>Built with care. Open source.</span>
    </div>

  </div>
</footer>

<style>
  .yy-footer {
    padding: 75px 0 25px;
    background: #101115;
    border-top: 1px solid var(--yy-border);
  }

  .footer-main {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 60px;
    padding-bottom: 55px;
  }

  .footer-brand p {
    margin-top: 20px;
    line-height: 1.8;
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    gap: 13px;
  }

  .footer-column h3 {
    margin-bottom: 8px;
    font-size: .9rem;
    letter-spacing: 0;
  }

  .footer-column a {
    color: var(--yy-muted);
    font-size: .88rem;
  }

  .footer-column a:hover {
    color: white;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding-top: 23px;
    color: var(--yy-subtle);
    font-size: .8rem;
  }

  @media(max-width: 650px) {
    .footer-main {
      grid-template-columns: 1fr 1fr;
      gap: 35px;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>

---
const links = [
  { label: 'Home', href: '/' },
  { label: 'How it works', href: '/how-it-works/' },
  { label: 'Privacy', href: '/privacy/' },
  { label: 'Documentation', href: '/docs/' }
];

const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="yy-navbar">
  <nav class="yy-container navbar-inner" aria-label="Main navigation">

    <a href={`${base}/`} class="yy-brand" aria-label="YesYouTube home">
      <img
        src={`${base}/media/logo.svg`}
        alt=""
        width="36"
        height="36"
      />
      <span>yes<span>YouTube</span></span>
    </a>

    <button
      class="yy-menu-toggle"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="yy-navigation"
    >
      <span></span>
      <span></span>
    </button>

    <div class="yy-nav-content" id="yy-navigation">

      <div class="yy-nav-links">
        {links.map((link) => {
          const href = `${base}${link.href}`;

          const active = link.href === '/'
            ? currentPath === `${base}/` || currentPath === base
            : currentPath.startsWith(href);

          return (
            <a
              href={href}
              class:list={['yy-nav-link', { active }]}
              aria-current={active ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })}
      </div>

      <a
        href="https://github.com/YOUR_USERNAME/YesYouTube"
        class="btn-yy btn-yy-primary yy-nav-cta"
        target="_blank"
        rel="noopener noreferrer"
      >
        View on GitHub <span aria-hidden="true">↗</span>
      </a>

    </div>
  </nav>
</header>

<style>
  .yy-navbar {
    position: sticky;
    top: 0;
    z-index: 1000;

    background: rgba(13,14,17,.86);
    backdrop-filter: blur(18px);
    border-bottom: 1px solid var(--yy-border);
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 82px;
  }

  .yy-brand {
    display: flex;
    align-items: center;
    gap: 11px;
    color: var(--yy-text);
    font-weight: 750;
    font-size: 1.1rem;
    letter-spacing: -.04em;
  }

  .yy-brand img {
    border-radius: 10px;
  }

  .yy-brand span span {
    color: var(--yy-red);
  }

  .yy-nav-content {
    display: flex;
    align-items: center;
    gap: 38px;
  }

  .yy-nav-links {
    display: flex;
    align-items: center;
    gap: 30px;
  }

  .yy-nav-link {
    color: var(--yy-muted);
    font-size: .88rem;
    font-weight: 550;
    transition: color .2s ease;
  }

  .yy-nav-link:hover,
  .yy-nav-link.active {
    color: var(--yy-text);
  }

  .yy-nav-cta {
    min-height: 43px;
    padding-inline: 17px;
    font-size: .85rem;
  }

  .yy-menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    padding: 12px;
    background: var(--yy-surface);
    border: 1px solid var(--yy-border);
    border-radius: 10px;
  }

  .yy-menu-toggle span {
    display: block;
    height: 2px;
    margin: 5px 0;
    background: white;
    transition: transform .2s ease;
  }

  @media (max-width: 850px) {
    .yy-menu-toggle {
      display: block;
    }

    .yy-nav-content {
      display: none;
      position: absolute;
      top: 81px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 22px;
      padding: 25px 24px 30px;

      background: #111318;
      border-bottom: 1px solid var(--yy-border);
    }

    .yy-nav-content.is-open {
      display: flex;
    }

    .yy-nav-links {
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
    }

    .yy-nav-link {
      font-size: 1rem;
    }

    .yy-nav-cta {
      justify-content: center;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.yy-menu-toggle');
  const navigation = document.querySelector<HTMLElement>('.yy-nav-content');

  if (toggle && navigation && !toggle.dataset.initialized) {
    toggle.dataset.initialized = 'true';

    toggle.addEventListener('click', () => {
      const isOpen = navigation.classList.toggle('is-open');

      toggle.setAttribute('aria-expanded', String(isOpen));
      toggle.setAttribute(
        'aria-label',
        isOpen ? 'Close navigation menu' : 'Open navigation menu'
      );
    });

    navigation.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) {
        navigation.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open navigation menu');
      }
    });
  }
</script>

---
const steps = [
  {
    number: '01',
    title: 'Clone the repository',
    description: 'Get the YesYouTube source code onto your computer.',
    command: 'git clone https://github.com/YOUR_USERNAME/YesYouTube.git'
  },
  {
    number: '02',
    title: 'Install dependencies',
    description: 'Install the development dependencies using npm.',
    command: 'npm install'
  },
  {
    number: '03',
    title: 'Build the extension',
    description: 'Generate the production extension inside dist/.',
    command: 'npm run build'
  },
  {
    number: '04',
    title: 'Load into your browser',
    description: 'Open the extensions page, enable Developer mode and load the dist/ directory using Load unpacked.',
    command: 'chrome://extensions/'
  }
];
---

<section class="yy-section" id="installation">
  <div class="yy-container">

    <div class="section-heading text-center mx-auto" data-reveal>
      <span class="eyebrow">Get started</span>

      <h2>Up and running in four steps.</h2>

      <p>
        Build the extension locally and load it into a
        Chromium-based browser.
      </p>
    </div>

    <div class="installation-list mt-5">

      {steps.map((step) => (
        <article class="installation-step" data-reveal>

          <div class="step-number">
            {step.number}
          </div>

          <div class="step-content">
            <h3>{step.title}</h3>
            <p>{step.description}</p>

            <div class="step-command">
              <code>{step.command}</code>
            </div>
          </div>

        </article>
      ))}

    </div>

    <div class="text-center mt-5" data-reveal>
      <a href="./docs/#installation" class="btn-yy btn-yy-outline">
        Full installation guide →
      </a>
    </div>

  </div>
</section>

<style>
  .installation-list {
    max-width: 800px;
    margin-inline: auto;
  }

  .installation-step {
    display: flex;
    gap: 25px;
    padding: 28px 0;
    border-bottom: 1px solid var(--yy-border);
  }

  .step-number {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    color: var(--yy-red);
    background: rgba(240,68,68,.1);
    border: 1px solid rgba(240,68,68,.18);
    border-radius: 13px;
    font-family: monospace;
    font-weight: 700;
  }

  .step-content {
    flex: 1;
    min-width: 0;
  }

  .step-content h3 {
    font-size: 1.15rem;
  }

  .step-content p {
    font-size: .9rem;
  }

  .step-command {
    padding: 14px 17px;
    background: #111216;
    border: 1px solid var(--yy-border);
    border-radius: 10px;
    overflow-x: auto;
  }

  .step-command code {
    color: #ff8585;
    font-size: .8rem;
    white-space: nowrap;
  }

  @media(max-width: 600px) {
    .installation-step {
      gap: 15px;
    }

    .step-number {
      width: 40px;
      height: 40px;
    }
  }
</style>

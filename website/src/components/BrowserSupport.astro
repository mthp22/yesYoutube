---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const browsers = [
  {
    name: 'Google Chrome',
    description: 'Load the unpacked Manifest V3 extension.',
    status: 'Supported',
    icon: 'browser-chrome.png'
  },
  {
    name: 'Microsoft Edge',
    description: 'Load the unpacked extension through Edge extensions.',
    status: 'Supported',
    icon: 'browser-edge.png'
  }
];

/* TODO(release): replace the null hrefs below.*/
const listings: Array<{
  name: string;
  store: string;
  icon: string;
  status: 'live' | 'pending';
  href: string | null;
}> = [
  {
    name: 'Microsoft Edge',
    store: 'Microsoft Edge Add-ons',
    icon: 'browser-edge.png',
    status: 'live',
    href: "https://microsoftedge.microsoft.com/addons/detail/yesyoutube/kkafepceokhpcoflhobmickkpmfknihk"
  },
  {
    name: 'Firefox',
    store: 'Firefox Add-ons (AMO)',
    icon: 'browser-firefox.png',
    status: 'live',
    href: "https://addons.mozilla.org/en-US/firefox/addon/yesyoutube/"
  }
];
---

<section class="yy-section-sm browser-section" id="browser-support">
  <div class="yy-container">

    <div class="section-heading text-center mx-auto" data-reveal>
      <span class="eyebrow">Compatibility</span>
      <h2>Built for Chromium browsers.</h2>
      <p>
        YesYouTube uses the Manifest V3 extension platform.
      </p>
    </div>

    <div class="row justify-content-center g-4 mt-4">

      {browsers.map((browser) => (
        <div class="col-md-5" data-reveal>

          <article class="browser-card">

            <div class="browser-icon">
              <img src={`${base}/media/${browser.icon}`} alt="" width="28" height="28" loading="lazy"
              />
            </div>

            <div class="browser-details">
              <h3>{browser.name}</h3>
              <p>{browser.description}</p>
              <span class="browser-status">
                ✓ {browser.status}
              </span>
            </div>

          </article>

        </div>
      ))}

    </div>

    <div class="get-extension mt-5" data-reveal>

      <div class="section-heading text-center mx-auto">
        <span class="eyebrow">Get extension</span>
        <h2>Install YesYouTube.</h2>
        <p>
          Store listings are under review. Placeholders below
          go live as soon as each listing is approved.
        </p>
      </div>

      <div class="row justify-content-center g-4 mt-4">

        {listings.map((listing) => (
          <div class="col-md-5">
            <article class="browser-card listing-card">

              <div class="browser-icon">
                <img
                  src={`${base}/media/${listing.icon}`}
                  alt=""
                  width="28"
                  height="28"
                  loading="lazy"
                />
              </div>

              <div class="browser-details">
                <h3>{listing.name}</h3>
                <p>{listing.store}</p>

                <span
                  class:list={[
                    'browser-status',
                    { 'is-pending': listing.status === 'pending' }
                  ]}
                >
                  {listing.status === 'pending'
                    ? 'Pending review'
                    : '✓ Available'}
                </span>

                {listing.status === 'live' && listing.href ? (
                  <a
                    href={listing.href}
                    class="btn-yy btn-yy-primary listing-cta"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Get extension <span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <>
                    <span
                      class="btn-yy btn-yy-outline listing-cta is-disabled"
                      aria-disabled="true"
                    >
                      Get extension
                    </span>
                    <span class="listing-cta-note">
                      Coming soon — pending store review.
                    </span>
                  </>
                )}
              </div>

            </article>
          </div>
        ))}

      </div>

    </div>

    <p class="browser-note text-center mt-4">
      YouTube and YouTube Music are the supported target websites.
    </p>

  </div>
</section>

<style>
  .browser-section {
    background: var(--yy-bg-soft);
  }

  .browser-card {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    height: 100%;
    padding: 28px;
    background: var(--yy-surface);
    border: 1px solid var(--yy-border);
    border-radius: var(--yy-radius-lg);
  }

  .browser-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 50px;
    height: 50px;
    background: var(--yy-surface-hover);
    border-radius: 14px;
  }

  .browser-icon img {
    width: 28px;
    height: 28px;
    object-fit: contain;
  }

  .browser-details h3 {
    font-size: 1.1rem;
  }

  .browser-details p {
    font-size: .85rem;
  }

  .browser-status {
    color: #46c985;
    font-size: .8rem;
    font-weight: 650;
  }

  .browser-note {
    color: var(--yy-subtle);
    font-size: .82rem;
  }

  .get-extension {
    padding-top: 45px;
    border-top: 1px solid var(--yy-border);
  }

  .listing-card .browser-details {
    flex: 1;
  }

  .listing-cta-note {
    display: block;
    margin-top: 8px;
    color: var(--yy-subtle);
    font-size: .74rem;
  }

  .listing-cta {
    display: flex;
    width: fit-content;
    max-width: 100%;
    min-height: 44px;
    margin-top: 16px;
    font-size: .85rem;
  }

  @media(max-width: 600px) {
    .listing-cta {
      width: 100%;
      text-align: center;
    }
  }

  .listing-cta.is-disabled {
    color: var(--yy-subtle);
    background: transparent;
    border-color: var(--yy-border);
    cursor: not-allowed;
    pointer-events: none;
  }

  .browser-status.is-pending {
    color: #e8b45c;
  }
</style>

---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

import '../styles/bootstrap.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'YesYouTube — Keep Watching',
  description = 'Automatically handle YouTube inactivity prompts with YesYouTube, a privacy-first Manifest V3 browser extension.'
} = Astro.props;

const pageTitle = title.includes('YesYouTube')
  ? title
  : `${title} | YesYouTube`;

const currentUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0e11" />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={currentUrl} />

    <link rel="icon" type="image/png" sizes="512x512" href={`${import.meta.env.BASE_URL}favicon.png`} />
    <script type="text/javascript">
        (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "zhseisyltt");
    </script>
    <title>{pageTitle}</title>
  </head>

  <body>
    <Navbar />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <script>
      import { initMotion } from '../scripts/motion';

      const initialize = () => {
        initMotion();
      };

      document.addEventListener('astro:page-load', initialize);

      initialize();
    </script>
  </body>
</html>
